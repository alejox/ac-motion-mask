// AC Motion Mask - mask + motion in a single pass.
// All colors are premultiplied alpha (OBS filter chain convention).

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d mask_image;

// 0 none, 1 rounded rectangle, 2 circle, 3 ellipse, 4 image, 5 gradient
uniform int mask_type;
uniform float2 source_size;   // pixels
uniform float2 mask_center;   // 0..1
uniform float2 mask_size;     // 0..1 of the source (already animated)
uniform float corner_radius;  // 0..1 of the shortest half side
uniform float feather;        // pixels
uniform float invert_mask;    // 0 or 1
uniform float image_channel;  // 0 alpha, 1 luminance
uniform float2 grad_dir;      // unit vector
uniform float grad_pos;       // 0..1
uniform float grad_width;     // 0..1

// motion
uniform float2 move_offset;   // in source widths/heights
uniform float move_scale;     // 1 = normal
uniform float opacity;        // 0..1
uniform float wipe_enabled;   // 0 or 1
uniform float2 wipe_dir;      // unit vector
uniform float wipe_progress;  // 0 hidden .. 1 shown
uniform float wipe_soft;      // 0..1

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float inside01(float2 p)
{
	return step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0);
}

float shape_alpha(float dist, float soft)
{
	// dist < 0 means inside the shape
	return 1.0 - smoothstep(-soft, 0.0, dist);
}

float mask_value(float2 uv)
{
	float soft = max(feather, 1.0);
	float2 p = (uv - mask_center) * source_size;
	float2 half_size = max(mask_size * source_size * 0.5, float2(0.0001, 0.0001));
	float short_half = min(half_size.x, half_size.y);
	float m = 1.0;

	if (mask_type == 1) {
		float r = clamp(corner_radius, 0.0, 1.0) * short_half;
		float2 q = abs(p) - half_size + float2(r, r);
		float d = length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;
		m = shape_alpha(d, soft);
	} else if (mask_type == 2) {
		float d = length(p) - short_half;
		m = shape_alpha(d, soft);
	} else if (mask_type == 3) {
		float d = (length(p / half_size) - 1.0) * short_half;
		m = shape_alpha(d, soft);
	} else if (mask_type == 4) {
		float2 muv = (uv - mask_center) / max(mask_size, float2(0.0001, 0.0001)) + float2(0.5, 0.5);
		float4 mc = mask_image.Sample(textureSampler, muv);
		float luma = dot(mc.rgb, float3(0.2126, 0.7152, 0.0722)) * mc.a;
		m = lerp(mc.a, luma, image_channel) * inside01(muv);
	} else if (mask_type == 5) {
		float span = abs(grad_dir.x) + abs(grad_dir.y);
		float t = dot(uv - float2(0.5, 0.5), grad_dir) / max(span, 0.0001) + 0.5;
		float w = max(grad_width, 0.001) * 0.5;
		m = 1.0 - smoothstep(grad_pos - w, grad_pos + w, t);
	}

	return lerp(m, 1.0 - m, invert_mask);
}

float4 PSMotionMask(VertData v_in) : TARGET
{
	float safe_scale = max(move_scale, 0.0001);
	float2 uv = (v_in.uv - float2(0.5, 0.5) - move_offset) / safe_scale + float2(0.5, 0.5);

	float4 color = image.Sample(textureSampler, uv) * inside01(uv);
	float a = mask_value(uv) * clamp(opacity, 0.0, 1.0);

	if (wipe_enabled > 0.5) {
		float span = abs(wipe_dir.x) + abs(wipe_dir.y);
		float t = dot(uv - float2(0.5, 0.5), wipe_dir) / max(span, 0.0001) + 0.5;
		float s = max(wipe_soft, 0.001);
		float edge = clamp(wipe_progress, 0.0, 1.0) * (1.0 + s);
		a *= 1.0 - smoothstep(edge - s, edge, t);
	}

	return color * a;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMotionMask(v_in);
	}
}
